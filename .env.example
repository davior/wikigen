# AI keys. Each connection picks Claude or DeepSeek (Connections → Edit → AI model);
# only the key for the providers you use is needed.
# Anthropic API key, for Claude connections (and connections saved before there was a choice)
ANTHROPIC_API_KEY=sk-ant-...
# DeepSeek API key, for DeepSeek connections: platform.deepseek.com → API keys (prepaid)
DEEPSEEK_API_KEY=

# Optional: stop an AI call that runs longer than this many minutes (default 30).
# AI_TIMEOUT_MINUTES=30
# Optional: DeepSeek's Anthropic-compatible endpoint (default shown).
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# fal.ai API key for AI image generation (optional).
# Normally set per connection in the UI (Connections → Edit → Image generation);
# this is only the fallback for connections without their own key.
FAL_KEY=

# Flask session secret — set to a long random string in production
FLASK_SECRET=change-me-to-a-random-string

# Minutes between keep-alive pings that stop the wiki expiring WikiGen's idle
# login (MediaWiki's default is an hour). 0 turns them off. Default: 10.
WIKI_KEEPALIVE_MINUTES=10

# Port to listen on (default: 5055)
PORT=5055

# Directory for connections.json, history.json, and plans/ (default: current dir)
DATA_DIR=.

# Fallback wiki connection — used if no connections.json exists yet.
# You can also add connections via the UI instead of setting these.
WIKI_URL=https://yourwiki.example.com/w/api.php
WIKI_NAME=My Wiki
WIKI_USERNAME=Username@BotPasswordName
WIKI_PASSWORD=your-bot-password-here

# Optional: shared-secret header sent as X-Wikigen-Token on every api.php
# request. Only needed if the wiki you're connecting to rate-limits/exempts
# requests based on this header (e.g. a wiki behind Caddy with
# caddy-ratelimit configured to exempt it). Leave blank if not applicable.
WIKIGEN_API_TOKEN=
